# Public app URL (no trailing slash)
APP_URL=http://127.0.0.1:43127

# Encrypted session cookie (≥ 32 characters)
SESSION_SECRET=dev-only-session-secret-change-me-32chars!!

# Authentik OIDC (separate app from Connect)
AUTHENTIK_ISSUER=https://sso.example.com/application/o/neuland-hr/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Authentik API (Mitglieder list + optional groups-claim fallback)
# Token needs read access to users and groups.
AUTHENTIK_API_URL=https://sso.example.com
AUTHENTIK_API_TOKEN=

# Group → role mapping (case-insensitive match on group name)
HR_GROUP_NAME=HR
VORSTAND_GROUP_NAME=Vorstand
# Same permissions as Vorstand; separate Authentik group
ADMIN_GROUP_NAME=Admin
# Dashboard “Mitglieder” count (Authentik group name)
MITGLIEDER_GROUP_NAME=mitglieder
# Technical accounts excluded from offboarding candidates
TECHNICAL_USERS_GROUP_NAME=technical-users

# Member-ID API (QR public key for scanner verification; no trailing slash)
MEMBER_ID_API_BASE=https://id.neuland-ingolstadt.de

# Local mock login only — must be set explicitly (never auto-enabled)
# AUTH_MOCK=true
