{
  "name": "neuland-hr",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 43127",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 43127",
    "start": "bun .output/server/index.mjs",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "backfill:easyverein": "bun run scripts/backfill-easyverein-ids.ts",
    "dev:email": "email dev --dir src/emails --port 3001",
    "docker:build": "docker build --build-arg BUN_VERSION=$(tr -d '[:space:]' < .bun-version) -t neuland-hr ."
  },
  "dependencies": {
    "@azure/communication-email": "1.1.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "9.3.1",
    "cborg": "6.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsqr": "1.4.0",
    "lucide-react": "1.60.0",
    "nitro": "3.0.260610-beta",
    "openid-client": "6.8.8",
    "pako": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tanstack/router-cli": "1.167.45",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/pako": "3.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxc-transform-react": "0.155.0",
    "react-email": "6.11.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
